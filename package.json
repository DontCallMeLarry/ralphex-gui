{
  "name": "terrarium",
  "version": "1.0.0",
  "private": true,
  "description": "Terrarium — a local worktree lifecycle dashboard, driven by ralphex",
  "type": "module",
  "scripts": {
    "start": "node server/main.ts",
    "build": "vite build",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "agent:install": "node scripts/agent.mjs install",
    "agent:uninstall": "node scripts/agent.mjs uninstall",
    "agent:status": "node scripts/agent.mjs status"
  },
  "dependencies": {
    "@dicebear/core": "^10.4.0",
    "@dicebear/styles": "^10.4.0",
    "dompurify": "^3.2.0",
    "express": "^5.1.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
